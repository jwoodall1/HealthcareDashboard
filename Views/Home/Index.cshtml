@{
    ViewData["Title"] = "Dashboard Home";
}

<div class="text-center mt-4 mb-5">
    <h1 class="display-4 fw-bold">Healthcare Dashboard</h1>
    <p class="lead text-muted">Central administration and directory management.</p>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <h3 class="card-title text-primary mb-3">🩺 Providers</h3>
                <p class="card-text text-muted mb-4">Manage your network of active healthcare professionals, NPI numbers, and specialties.</p>
                <a asp-controller="Providers" asp-action="Index" class="btn btn-outline-primary w-100">View Directory</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <h3 class="card-title text-success mb-3">📋 Patients</h3>
                <p class="card-text text-muted mb-4">Access registered patient records, verify demographics, and update contact information.</p>
                <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-success w-100">View Roster</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <h3 class="card-title text-info mb-3">📅 Encounters</h3>
                <p class="card-text text-muted mb-4">Schedule, track, and review medical appointments between network patients and providers.</p>
                <a asp-controller="Encounters" asp-action="Index" class="btn btn-outline-info w-100">View Schedule</a>
            </div>
        </div>
    </div>
</div>