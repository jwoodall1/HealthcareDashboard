@model HealthcareDashboard.Models.Provider

@{
    ViewData["Title"] = "Create Provider";
}

<div class="container mt-4">
    <h2>Add New Provider</h2>
    <hr />
    
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="FirstName" class="control-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="LastName" class="control-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NpiNumber" class="control-label">NPI Number (10 digits)</label>
                    <input asp-for="NpiNumber" class="form-control" />
                    <span asp-validation-for="NpiNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Specialty" class="control-label">Specialty</label>
                    <input asp-for="Specialty" class="form-control" placeholder="e.g., Cardiology, Pediatrics" />
                    <span asp-validation-for="Specialty" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PhoneNumber" class="control-label">Phone Number (Optional)</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Save Provider" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>