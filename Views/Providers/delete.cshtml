@model HealthcareDashboard.Models.Provider

@{ ViewData["Title"] = "Delete Provider"; }

<div class="container mt-4">
    <h2 class="text-danger">Are you sure you want to delete this provider?</h2>
    <p>This action cannot be undone.</p>
    <hr />
    
    <dl class="row mt-3">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        
        <dt class="col-sm-3">Specialty</dt>
        <dd class="col-sm-9">@Model.Specialty</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>