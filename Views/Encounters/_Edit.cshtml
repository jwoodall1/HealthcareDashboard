@model HealthcareDashboard.Models.Encounter

<form id="editEncounterForm" asp-action="Edit">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    
    <div class="form-group mb-3">
        <label asp-for="PatientId" class="control-label"></label>
        <select asp-for="PatientId" class="form-control" asp-items="ViewBag.PatientId"></select>
        <span asp-validation-for="PatientId" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ProviderId" class="control-label"></label>
        <select asp-for="ProviderId" class="form-control" asp-items="ViewBag.ProviderId"></select>
        <span asp-validation-for="ProviderId" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="EncounterDate" class="control-label"></label>
        <input asp-for="EncounterDate" class="form-control" type="datetime-local" />
        <span asp-validation-for="EncounterDate" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ChiefComplaint" class="control-label"></label>
        <input asp-for="ChiefComplaint" class="form-control" />
        <span asp-validation-for="ChiefComplaint" class="text-danger"></span>
    </div>
    
    
    <div class="modal-footer mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>